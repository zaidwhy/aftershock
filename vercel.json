{
  "functions": {
    "api/index.py": {
      "includeFiles": "{aftershock/**,data/private/**,data/public/**}"
    }
  },
  "rewrites": [
    { "source": "/api/:rest*", "destination": "/api/index?__path=/api/:rest*" },
    { "source": "/health", "destination": "/api/index?__path=/health" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
